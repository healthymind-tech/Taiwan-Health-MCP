{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/providers/testUtil.ts",
    "src/grounding/testkit.ts",
    "src/grounding/pasEval.ts",
    "src/grounding/pasTestkit.ts",
    "src/grounding/pasHandRecords.ts",
    "src/grounding/scripts/**"
  ]
}
