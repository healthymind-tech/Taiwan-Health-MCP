# ── Admin worker image ────────────────────────────────────────────────────────
# The Node worker (node-server/dist/admin/adminWorker.js) claims jobs and runs
# every stage — the deterministic file loaders, the embedding backfill, and the
# drug pipeline (TFDA crawl → MinIO → OCR → analysis LLM). The drug stages used
# to be delegated to a bundled Python shim; they are native TypeScript now, so
# this image ships a single runtime.
#
# OCR is an external MinerU HTTP service the pipeline uploads PDFs to, not a
# library — which is what made the drug closure portable in the first place.
#
# Build context is the repo root (see compose.yaml `admin-worker.build`).

# ── node build (TS -> dist) ───────────────────────────────────────────────────
FROM node:20-slim AS nodebuild
WORKDIR /nb
COPY node-server/package.json node-server/package-lock.json ./
RUN npm ci
COPY node-server/tsconfig.json ./
COPY node-server/src ./src
RUN npm run build
# Drop dev deps so the runtime image only ships production deps.
RUN npm prune --omit=dev

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:20-slim
WORKDIR /app

COPY --from=nodebuild /nb/dist ./node-server/dist
COPY --from=nodebuild /nb/node_modules ./node-server/node_modules
COPY node-server/package.json ./node-server/package.json

# The Analysis LM system prompt ships with the code and is read at analysis time.
COPY src/prompts/ ./src/prompts/

ENV NODE_ENV=production \
    DRUG_ANALYSIS_PROMPT_PATH=/app/src/prompts/drug/analysis_prompt.txt

WORKDIR /app/node-server
CMD ["node", "dist/admin/adminWorker.js"]
