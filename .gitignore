# 忽略 Python 編譯檔
__pycache__/
*.pyc

# 忽略虛擬環境
venv/
.env

# 忽略生成的資料庫 (因為每次都可以由 Excel 重建)
*.db

# Source data (ICD / LOINC / SNOMED / RxNorm / UMLS / IG packages) stays out of git:
# the archives are large, several are licence-restricted, and all of them are
# re-downloadable — docs/data-sources/test-data.md records where each one came from.
# The two lookup tables that are ours (and downloadable nowhere) live in data/loinc/.
fhir-code/

# 忽略作業系統縮圖
.DS_Store

.claude

# Ignore Codex agent marker file
.codex

# 忽略 MkDocs 構建產物（文檔源文件保留，只排除構建結果）
site/

# 忽略 MkDocs 快取
.cache/

# Ignore local dataset configuration; keep the example template in version control
config/datasets.yaml

.gstack/

# Node.js build artifacts (Next.js web/ + node-server/ gateway)
node_modules/
.next/
out/
node-server/dist/
*.tsbuildinfo
next-env.d.ts

# Playwright MCP test artifacts
.playwright-mcp/
