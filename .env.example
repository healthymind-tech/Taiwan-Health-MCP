# ============================================================================
# Taiwan Health MCP Server — environment configuration
# Copy to .env and edit. `docker compose up -d` reads it automatically.
#
# Two tiers live in this file:
#   1. BOOTSTRAP  — read from the environment on every start. The only place
#                   these can be set.
#   2. SEED-ONLY  — read ONCE on first boot to populate admin.app_settings.
#                   After that the database wins and editing them here does
#                   nothing; manage them in the admin console → 外部服務
#                   (/admin/integrations).
# Model endpoints (embedding, Analysis LM, OCR) are in neither tier — they are
# configured only in the admin console. See the note at the bottom.
#
# Not here either: BUILD_SHA (the git sha health_check reports as `build`) is a
# Docker build arg of node-server/Dockerfile, not a runtime variable — see
# docs/deployment/index.md.
#
# Escaping: Compose expands `$` in this file. Any value containing `$` must
# double it (`$$`), or it is silently truncated. Applies to passwords and
# secrets below.
# ============================================================================


# ============================================================================
# BOOTSTRAP
# ============================================================================

# --- Must change before first boot ------------------------------------------
# These two placeholders are published in this repository, so the server refuses
# to start while either is still in place. ADMIN_SESSION_SECRET signs the admin
# session cookie: anyone holding it can mint a session for any user without ever
# touching the password.
#   POSTGRES_PASSWORD:    openssl rand -hex 24
#   ADMIN_SESSION_SECRET: openssl rand -hex 32
POSTGRES_PASSWORD=changeme_strong_password
ADMIN_SESSION_SECRET=change_this_admin_session_secret
# Symmetric pgcrypto key for external FHIR server OAuth tokens / client secrets.
# Falls back to ADMIN_SESSION_SECRET when blank. MUST match on `app` and
# `admin-worker`, or the worker fails to decrypt: "Illegal argument to function"
# (empty key) / "Wrong key or corrupt data" (mismatched key).
FHIR_SERVER_SECRET_KEY=

# --- Front door -------------------------------------------------------------
# nginx is the only service published to the host; all traffic, MCP included,
# goes through this port.
WEB_PORT=8080

# --- MCP transport ----------------------------------------------------------
# The server always serves streamable-http on the HTTP listener; there is no
# transport switch.
MCP_HOST=0.0.0.0
# Container-internal port, not published. Clients connect to
# http://<host>:${WEB_PORT}${MCP_PATH}
MCP_PORT=8000
MCP_PATH=/mcp

# --- Public tool surface auth (/mcp, /openapi.json, /tools/*) ---------------
# PUBLIC_TOOLS_AUTH_MODE: none | bearer. Keep `none` only on trusted local or
# private networks; use `bearer` with a long random token in production.
PUBLIC_TOOLS_AUTH_MODE=none
PUBLIC_TOOLS_BEARER_TOKEN=
# Comma-separated browser origins. Blank = `*` in none mode; in bearer mode it
# disables cross-origin browser access (same-origin and non-browser still work).
PUBLIC_TOOLS_CORS_ORIGINS=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=taiwan_health
POSTGRES_USER=mcp
# DATABASE_URL and REDIS_URL are built by compose from the values above (via
# pgBouncer). Set them by hand only when running outside Docker:
# DATABASE_URL=postgresql://mcp:changeme@localhost:5432/taiwan_health
# REDIS_URL=redis://localhost:6379/0

# --- Logging and metrics ----------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Structured JSON to stderr.
LOG_LEVEL=INFO
# Prometheus /metrics port, published on 127.0.0.1 only.
METRICS_PORT=9090

# --- Admin console ----------------------------------------------------------
# On by default: /admin is the only way to import any data, so a fresh install
# needs it. Set false once the data is loaded to shrink the attack surface of a
# publicly exposed deployment — MCP tools, the worker and scheduled imports all
# keep running without it; only the operator UI and its API go away.
#
# Status codes tell you which state you are in: 404 = console off, 503 = on but
# missing one of the settings below, 401 = on and configured, wrong credentials.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
# Seeds the operator credential on first boot, when admin.admin_credentials has
# no row for ADMIN_USERNAME. Seeding runs whether or not ADMIN_ENABLED is true.
# The value is hashed before storage and the row is never overwritten
# afterwards, so changing this later has no effect — change the password in
# Admin → 帳號安全 (/admin/security) instead. Remove this line once seeded.
ADMIN_INITIAL_PASSWORD=
ADMIN_SESSION_TTL_MINUTES=240
# Blank derives from PUBLIC_BASE_URL: HTTPS enables Secure, HTTP/blank does not.
# Set explicitly when TLS terminates at a proxy whose public URL is unset.
ADMIN_COOKIE_SECURE=
ADMIN_MAX_UPLOAD_MB=512
# Total concurrent worker jobs. Imports also take a per-module slot, so
# ICD/LOINC/IG/SNOMED can still run in parallel; this bounds peak memory.
ADMIN_MAX_CONCURRENT_JOBS=4

# --- Public origin and passkeys ---------------------------------------------
# Builds the OAuth2 redirect_uri and derives the WebAuthn RP ID.
# Blank -> derived from the request Host header.
# PUBLIC_BASE_URL=https://taiwan-health-mcp.example.com
#
# Passkeys (Touch ID / Face ID / security keys) are an extra admin login method
# alongside the password, and need HTTPS on the RP domain (or localhost). All
# three are optional and default from PUBLIC_BASE_URL.
# WEBAUTHN_RP_ID=taiwan-health-mcp.example.com     # registrable domain
# WEBAUTHN_RP_NAME=Taiwan Health MCP — Admin       # shown in the OS prompt
# WEBAUTHN_ORIGIN=https://taiwan-health-mcp.example.com   # comma-separated

# --- Drug pipeline ----------------------------------------------------------
# Licenses per AUTO-CHAINED drug job (index -> enrichment -> analysis), so the
# backlog drains in slices an operator can stop between. It does NOT bound a
# manually queued job: queueing drug_enrichment without a `limit` crawls the
# entire pending queue — tens of thousands of requests against the TFDA site.
DRUG_AUTOCHAIN_BATCH_LIMIT=200


# ============================================================================
# SEED-ONLY — first boot populates admin.app_settings, then the database wins.
# Editing anything below on an already-initialised install has no effect.
# ============================================================================

# --- MinIO (drug assets) ----------------------------------------------------
# Docker: the service name. Outside Docker: localhost:9000.
# Set the credentials before the FIRST boot: the minio container re-reads them
# every start, but `app` / `admin-worker` use the copy seeded into the database,
# so changing them later desynchronises the two and object storage breaks.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=taiwan-health-drug-assets
MINIO_SECURE=false
MINIO_PRESIGN_TTL_SECONDS=3600

# --- TFDA crawler -----------------------------------------------------------
DRUG_TFDA_BASE_URL=https://mcp.fda.gov.tw
DRUG_HTTP_TIMEOUT=30
DRUG_CRAWLER_CONCURRENCY=4

# --- Worker tuning ----------------------------------------------------------
ADMIN_WORKER_NAME=admin-worker
ADMIN_WORKER_POLL_SECONDS=3
ADMIN_HEARTBEAT_INTERVAL_SECONDS=15
ADMIN_WORKER_STALE_AFTER_SECONDS=45


# ============================================================================
# NOT configurable here: embedding, Analysis LM, OCR
# ============================================================================
# Embedding and Analysis LM endpoints are provider accounts + routes set in the
# admin console → 模型端點 (/admin/models) and stored in admin.llm_providers /
# admin.llm_routes / admin.llm_route_members / admin.llm_role_routes (the old
# admin.llm_profiles table survives only as admin.llm_profiles_legacy). The OCR
# provider (MinerU URL, or `indra` → http://ocr-indra:8000, plus an optional
# fallback) is set in → 外部服務 (/admin/integrations) and stored in
# admin.app_settings. Nothing is seeded from this file — an endpoint, model and
# API key have no sensible machine-wide default, and a typo here used to become
# permanent state. Use 備份與設定 (/admin/system) → settings Export / Import to
# move a working configuration between installs.


# ============================================================================
# ocr-indra (optional CPU OCR container, services/ocr-indra) — sizing only
# ============================================================================
# The container is capped at 2 CPUs / 2 GB in compose.yaml. Whether it is used is
# decided in the admin console (外部服務 → OCR → provider / fallback = indra).
# Model weights are under a modified OpenRAIL-M licence with commercial
# restrictions — read services/ocr-indra/README.md before enabling it.
# INDRA_WORKERS=1               # documents OCR'd in parallel (one model copy each)
# INDRA_THREADS_PER_WORKER=2    # CPU threads per document
# INDRA_MAX_PAGES=60            # longer documents are cut
# INDRA_MAX_UPLOAD_MB=50
