# ===========================================
# Taiwan Health MCP Server - 環境變數配置
# ===========================================
# 複製此檔案為 .env 並根據需求修改

# -----------------------------------------
# MCP 傳輸模式配置
# -----------------------------------------
# 可選值: stdio | streamable-http | sse
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# -----------------------------------------
# PostgreSQL
# -----------------------------------------
POSTGRES_DB=taiwan_health
POSTGRES_USER=mcp
POSTGRES_PASSWORD=changeme_strong_password

# DATABASE_URL is constructed automatically by docker-compose from the above
# (routed through pgBouncer on port 6432).
# Set manually only when running outside Docker:
# DATABASE_URL=postgresql://mcp:changeme@localhost:5432/taiwan_health

# -----------------------------------------
# Redis
# -----------------------------------------
# REDIS_URL is set automatically by docker-compose.
# Set manually only when running outside Docker:
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------
# Metrics (Prometheus)
# -----------------------------------------
# Prometheus /metrics endpoint port (exposed on 127.0.0.1 only).
METRICS_PORT=9090

# -----------------------------------------
# Application
# -----------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------
# Admin Console
# -----------------------------------------
# Keep disabled by default. When enabled, /admin becomes available and requires
# the configured operator credentials.
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
# Supported formats:
#   sha256$<hex_digest>
#   pbkdf2_sha256$<iterations>$<salt>$<hex_digest>
# Example SHA-256 generator:
#   python -c "import hashlib; print('sha256$' + hashlib.sha256(b'change-me').hexdigest())"
#
# ⚠️  IMPORTANT under Docker Compose: Compose interpolates variables in this
# .env file, so a single `$` is read as a variable reference and your hash gets
# silently truncated when the digest starts with a letter (e.g.
# `sha256$abc…` -> `sha256`). ALWAYS escape every `$` as `$$` here — Compose
# collapses `$$` back to a single `$` before the app sees it. Example:
#   ADMIN_PASSWORD_HASH=sha256$$1a2b3c...        # note the doubled $$
# pbkdf2 hashes contain several `$` — double each one. (See issue #21.)
ADMIN_PASSWORD_HASH=
# If your session secret contains a `$`, double it to `$$` for the same reason.
ADMIN_SESSION_SECRET=change_this_admin_session_secret
ADMIN_SESSION_TTL_MINUTES=240
ADMIN_MAX_UPLOAD_MB=512
ADMIN_WORKER_NAME=admin-worker
ADMIN_WORKER_POLL_SECONDS=3
ADMIN_HEARTBEAT_INTERVAL_SECONDS=15
ADMIN_WORKER_STALE_AFTER_SECONDS=45
# Max jobs the worker runs concurrently. Dataset imports are slotted per dataset
# (ICD/LOINC/TWCore/SNOMED can run in parallel); this caps the total to bound
# peak memory. 0 = no cap (resource slots only).
ADMIN_MAX_CONCURRENT_JOBS=5

# --- Passkeys / WebAuthn (optional) ----------------------------------------
# Passkeys (Touch ID / Face ID / security keys) are an additional admin login
# method alongside the password. They only work over HTTPS on the RP domain
# (or localhost for dev). All three keys are optional and derive sensible
# defaults from PUBLIC_BASE_URL:
#   WEBAUTHN_RP_ID   - registrable domain the console is served from.
#                      Default: host of PUBLIC_BASE_URL, else taiwan-health-mcp.gugulu.tw
#   WEBAUTHN_RP_NAME - display name shown in the OS passkey prompt.
#   WEBAUTHN_ORIGIN  - comma-separated allow-list of expected origins.
#                      Default: https://<WEBAUTHN_RP_ID>. Add e.g.
#                      http://localhost:3000 for local development.
# WEBAUTHN_RP_ID=taiwan-health-mcp.gugulu.tw
# WEBAUTHN_RP_NAME=Taiwan Health MCP — Admin
# WEBAUTHN_ORIGIN=https://taiwan-health-mcp.gugulu.tw

# ===========================================================================
# SEED-ONLY DEFAULTS for infrastructure systems (everything below).
# These (MinIO, TFDA crawler, FHIR registry, worker tuning) are read ONCE on
# first boot to seed admin.app_settings when it is empty. After that, manage and
# test them in the admin console → Settings tab; editing .env here has no effect
# on an already-seeded database. (Bootstrap vars above — DB/Redis/MCP/ADMIN_* —
# are NOT in the DB and must stay in .env.)
#
# The model-serving settings (embedding, Analysis LM, OCR) are NOT here at all:
# they are configured only in the admin console. See below.
# ===========================================================================

# -----------------------------------------
# Embedding / Analysis LM / OCR — NOT configurable here
# -----------------------------------------
# These three services are configured in the admin console (Settings tab) and
# stored in admin.app_settings. Nothing is seeded from this file: an endpoint,
# model and API key have no sensible machine-wide default, and a typo here used
# to become permanent state. Use Settings → Export / Import to move a working
# configuration between installs.

# -----------------------------------------
# MinIO (Drug Assets)
# -----------------------------------------
# Docker: use the service name — MINIO_ENDPOINT=minio:9000
# Local (outside Docker): use localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=taiwan-health-drug-assets
MINIO_SECURE=false
MINIO_PRESIGN_TTL_SECONDS=3600

# -----------------------------------------
# Drug TFDA Enrichment
# -----------------------------------------
DRUG_TFDA_BASE_URL=https://mcp.fda.gov.tw
DRUG_HTTP_TIMEOUT=30
DRUG_CRAWLER_CONCURRENCY=4
